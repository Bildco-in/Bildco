# Copy to .env (or .env.local) and fill in. Never commit real keys.

# Sarvam AI: speech-to-text, text-to-speech, and (by default) the reply LLM.
# https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional: Sarvam bulbul:v3 voice name (not the model). Defaults to "priya".
SARVAM_TTS_SPEAKER=

# Optional: Sarvam chat model. Defaults to sarvam-105b.
SARVAM_LLM_MODEL=

# Optional: use OpenRouter for replies instead of Sarvam.
# LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Model id, or a comma-separated list to fall back through.
# Defaults to anthropic/claude-haiku-5.5.
OPENROUTER_MODEL=
